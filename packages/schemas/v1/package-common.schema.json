{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/claude-code-foundry/packages/v1/package-common.schema.json",
  "title": "Governed package common definitions",
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hosts", "profiles"],
      "properties": {
        "hosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "versionRange"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "versionRange": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["direct", "apim-governed"]
          }
        }
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "access", "justification"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*$"
        },
        "access": {
          "enum": ["read", "invoke", "write"]
        },
        "justification": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "allowedResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "selector", "actions"],
      "properties": {
        "type": {
          "enum": ["foundry-deployment", "mcp-tool", "https-origin", "workspace-path"]
        },
        "selector": {
          "type": "string",
          "minLength": 1
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["read", "invoke", "write"]
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRepository", "sourceRevision", "buildSystem", "builtAt"],
      "properties": {
        "sourceRepository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "sourceRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "buildSystem": {
          "type": "string",
          "minLength": 1
        },
        "builtAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "signing"],
      "properties": {
        "digest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "value"],
          "properties": {
            "algorithm": {
              "const": "sha256"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "signing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "method", "identity"],
          "properties": {
            "required": {
              "const": true
            },
            "method": {
              "enum": ["sigstore", "x509"]
            },
            "identity": {
              "type": "string",
              "minLength": 1
            },
            "transparencyLogUrl": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "since"],
      "properties": {
        "state": {
          "enum": ["draft", "active", "deprecated", "retired"]
        },
        "since": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["team", "contact", "repository"],
      "properties": {
        "team": {
          "type": "string",
          "minLength": 1
        },
        "contact": {
          "type": "string",
          "format": "email"
        },
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    },
    "tenantEligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "policyReference"],
      "properties": {
        "mode": {
          "enum": ["policy-evaluated", "all-configured-tenants"]
        },
        "policyReference": {
          "type": "string",
          "minLength": 1
        },
        "requiredClaims": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
          }
        }
      }
    },
    "deprecation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "announcedAt", "effectiveAt", "replacementPackageId"],
      "properties": {
        "status": {
          "enum": ["not-announced", "announced"]
        },
        "announcedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "effectiveAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "replacementPackageId": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
        },
        "message": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
