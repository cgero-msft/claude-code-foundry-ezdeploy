{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/claude-code-foundry/packages/v1/skill.schema.json",
  "title": "Governed skill package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageType",
    "identity",
    "compatibility",
    "entrypoint",
    "permissions",
    "allowedResources",
    "provenance",
    "integrity",
    "lifecycle",
    "ownership",
    "tenantEligibility",
    "deprecation"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "packageType": {
      "const": "skill"
    },
    "identity": {
      "$ref": "package-common.schema.json#/$defs/identity"
    },
    "compatibility": {
      "$ref": "package-common.schema.json#/$defs/compatibility"
    },
    "entrypoint": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:|/|.*\\.\\.).+\\.md$"
    },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "package-common.schema.json#/$defs/permission"
      }
    },
    "allowedResources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "package-common.schema.json#/$defs/allowedResource"
      }
    },
    "provenance": {
      "$ref": "package-common.schema.json#/$defs/provenance"
    },
    "integrity": {
      "$ref": "package-common.schema.json#/$defs/integrity"
    },
    "lifecycle": {
      "$ref": "package-common.schema.json#/$defs/lifecycle"
    },
    "ownership": {
      "$ref": "package-common.schema.json#/$defs/ownership"
    },
    "tenantEligibility": {
      "$ref": "package-common.schema.json#/$defs/tenantEligibility"
    },
    "deprecation": {
      "$ref": "package-common.schema.json#/$defs/deprecation"
    }
  }
}
