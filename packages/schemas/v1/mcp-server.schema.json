{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/claude-code-foundry/packages/v1/mcp-server.schema.json",
  "title": "Governed MCP server package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageType",
    "identity",
    "compatibility",
    "endpoint",
    "permissions",
    "allowedResources",
    "provenance",
    "integrity",
    "lifecycle",
    "ownership",
    "tenantEligibility",
    "deprecation"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "packageType": {
      "const": "mcp-server"
    },
    "identity": {
      "$ref": "package-common.schema.json#/$defs/identity"
    },
    "compatibility": {
      "$ref": "package-common.schema.json#/$defs/compatibility"
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "transport"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "transport": {
          "enum": ["streamable-http", "sse"]
        },
        "healthPath": {
          "type": "string",
          "pattern": "^/"
        }
      }
    },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "package-common.schema.json#/$defs/permission"
      }
    },
    "allowedResources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "package-common.schema.json#/$defs/allowedResource"
      }
    },
    "provenance": {
      "$ref": "package-common.schema.json#/$defs/provenance"
    },
    "integrity": {
      "$ref": "package-common.schema.json#/$defs/integrity"
    },
    "lifecycle": {
      "$ref": "package-common.schema.json#/$defs/lifecycle"
    },
    "ownership": {
      "$ref": "package-common.schema.json#/$defs/ownership"
    },
    "tenantEligibility": {
      "$ref": "package-common.schema.json#/$defs/tenantEligibility"
    },
    "deprecation": {
      "$ref": "package-common.schema.json#/$defs/deprecation"
    }
  }
}
