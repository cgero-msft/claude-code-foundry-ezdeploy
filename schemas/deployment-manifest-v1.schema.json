{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cgero-msft/claude-code-on-foundry-ezdeploy/schemas/deployment-manifest-v1.schema.json",
  "title": "Claude Code on Foundry customer deployment manifest",
  "description": "Version 1 contract for an exact, repeatable customer deployment. Secret values are forbidden; only references are allowed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "release",
    "customer",
    "environment",
    "architecture",
    "azure",
    "models",
    "familyDefaults",
    "identities",
    "personas",
    "networking",
    "governance",
    "observability",
    "secretReferences",
    "packages",
    "ownership",
    "lifecycle",
    "cleanup"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$",
      "description": "Manifest contract version. Validators reject unknown major versions."
    },
    "release": {
      "$ref": "#/$defs/release"
    },
    "customer": {
      "$ref": "#/$defs/customer"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "architecture": {
      "$ref": "#/$defs/architecture"
    },
    "azure": {
      "$ref": "#/$defs/azureTarget"
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/modelDeployment"
      }
    },
    "familyDefaults": {
      "$ref": "#/$defs/familyDefaults"
    },
    "identities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/identity"
      }
    },
    "personas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/persona"
      }
    },
    "networking": {
      "$ref": "#/$defs/networking"
    },
    "governance": {
      "$ref": "#/$defs/governance"
    },
    "observability": {
      "$ref": "#/$defs/observability"
    },
    "secretReferences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/secretReference"
      }
    },
    "packages": {
      "$ref": "#/$defs/packages"
    },
    "ownership": {
      "$ref": "#/$defs/ownership"
    },
    "lifecycle": {
      "$ref": "#/$defs/lifecycle"
    },
    "cleanup": {
      "$ref": "#/$defs/cleanup"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "azureResourceId": {
      "type": "string",
      "pattern": "^/subscriptions/[0-9a-fA-F-]{36}/resourceGroups/[^/]+/providers/[^/]+/.+$"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "artifact"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "artifact": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sourceRevision": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,40}$"
        }
      }
    },
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "legalOrganization",
        "countryCode",
        "industry"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "displayName": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "legalOrganization": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "countryCode": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "industry": {
          "enum": [
            "technology",
            "finance",
            "healthcare",
            "education",
            "retail",
            "manufacturing",
            "government",
            "media",
            "other"
          ]
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "classification"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/slug"
        },
        "classification": {
          "enum": [
            "development",
            "test",
            "staging",
            "production"
          ]
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "status",
        "deployable"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Deployable profiles are direct and apim-governed. Other names are reserved for proposed, non-deployable profiles."
        },
        "status": {
          "enum": [
            "deployable",
            "proposed"
          ]
        },
        "deployable": {
          "type": "boolean"
        },
        "proposal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "trackingReference"
          ],
          "properties": {
            "owner": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "trackingReference": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        }
      }
    },
    "azureTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantId",
        "subscriptionId",
        "resourceGroup",
        "location",
        "foundry"
      ],
      "properties": {
        "tenantId": {
          "$ref": "#/$defs/uuid"
        },
        "subscriptionId": {
          "$ref": "#/$defs/uuid"
        },
        "resourceGroup": {
          "type": "string",
          "minLength": 1,
          "maxLength": 90,
          "pattern": "^(?!.*\\.$)[A-Za-z0-9_.()-]+$"
        },
        "location": {
          "enum": [
            "eastus2",
            "swedencentral"
          ]
        },
        "foundry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "accountName",
            "projectName",
            "reuseExisting"
          ],
          "properties": {
            "accountName": {
              "$ref": "#/$defs/slug"
            },
            "projectName": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,62}[A-Za-z0-9]$"
            },
            "reuseExisting": {
              "type": "boolean"
            }
          }
        },
        "apim": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "serviceName",
            "reuseExisting",
            "publisherName",
            "publisherEmail",
            "sku",
            "publicNetworkAccess",
            "api"
          ],
          "properties": {
            "serviceName": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,48}[a-z0-9]$",
              "maxLength": 50
            },
            "reuseExisting": {
              "const": false,
              "description": "Version 1 does not adopt an unrelated APIM service; ownership-tagged reruns are idempotent."
            },
            "publisherName": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "publisherEmail": {
              "type": "string",
              "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
            },
            "sku": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "capacity"
              ],
              "properties": {
                "name": {
                  "enum": [
                    "Developer",
                    "BasicV2",
                    "StandardV2",
                    "Premium"
                  ]
                },
                "capacity": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "publicNetworkAccess": {
              "const": "Enabled"
            },
            "api": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "path",
                "callerAudience",
                "allowedPrincipalIds",
                "rateLimitCalls",
                "rateLimitRenewalSeconds",
                "backendTimeoutSeconds"
              ],
              "properties": {
                "name": {
                  "const": "claude-foundry",
                  "description": "Stable API identifier. Changing it would leave a superseded public API."
                },
                "path": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{1,79}$"
                },
                "callerAudience": {
                  "const": "https://cognitiveservices.azure.com"
                },
                "allowedPrincipalIds": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 100,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/uuid"
                  }
                },
                "rateLimitCalls": {
                  "type": "integer",
                  "minimum": 1
                },
                "rateLimitRenewalSeconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 300
                },
                "backendTimeoutSeconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 240
                }
              }
            }
          }
        }
      }
    },
    "modelDeployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "publisher",
        "format",
        "name",
        "version",
        "sku",
        "deployment"
      ],
      "properties": {
        "family": {
          "enum": [
            "sonnet",
            "haiku",
            "opus"
          ]
        },
        "publisher": {
          "const": "Anthropic"
        },
        "format": {
          "const": "Anthropic"
        },
        "name": {
          "type": "string",
          "pattern": "^claude-(sonnet|haiku|opus)-[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "sku": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "capacity"
          ],
          "properties": {
            "name": {
              "const": "GlobalStandard"
            },
            "capacity": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "deployment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "versionUpgradeOption"
          ],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,62}[A-Za-z0-9])?$",
              "maxLength": 64
            },
            "versionUpgradeOption": {
              "const": "NoAutoUpgrade"
            }
          }
        }
      }
    },
    "familyDefaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sonnet": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "haiku": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "opus": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "purpose"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/slug"
        },
        "type": {
          "enum": [
            "system-assigned",
            "user-assigned",
            "entra-principal"
          ]
        },
        "purpose": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "resourceId": {
          "$ref": "#/$defs/azureResourceId"
        },
        "objectId": {
          "$ref": "#/$defs/uuid"
        }
      }
    },
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "identity",
        "roles"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/slug"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "identity": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "networking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "publicNetworkAccess"
      ],
      "properties": {
        "mode": {
          "enum": [
            "public",
            "private-endpoint"
          ]
        },
        "publicNetworkAccess": {
          "enum": [
            "Enabled",
            "Disabled"
          ]
        },
        "allowedCidrs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "privateEndpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subnetResourceId",
            "privateDnsZoneResourceId"
          ],
          "properties": {
            "subnetResourceId": {
              "$ref": "#/$defs/azureResourceId"
            },
            "privateDnsZoneResourceId": {
              "$ref": "#/$defs/azureResourceId"
            }
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataClassification",
        "allowedRegions",
        "localAuthentication",
        "marketplaceTermsAccepted",
        "billableResourcesApproved",
        "policyMode"
      ],
      "properties": {
        "dataClassification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "highly-confidential"
          ]
        },
        "allowedRegions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "eastus2",
              "swedencentral"
            ]
          }
        },
        "localAuthentication": {
          "enum": [
            "disabled",
            "preserve-on-reuse"
          ]
        },
        "marketplaceTermsAccepted": {
          "const": true
        },
        "billableResourcesApproved": {
          "const": true
        },
        "policyMode": {
          "enum": [
            "audit",
            "enforce"
          ]
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnosticSettings",
        "logRetentionDays",
        "costAlerts"
      ],
      "properties": {
        "diagnosticSettings": {
          "type": "boolean"
        },
        "logRetentionDays": {
          "type": "integer",
          "minimum": 30,
          "maximum": 730
        },
        "costAlerts": {
          "const": false,
          "description": "Cost alerts are not created by the version 1 scaffold."
        }
      }
    },
    "secretReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "provider",
        "reference",
        "purpose"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/slug"
        },
        "provider": {
          "enum": [
            "key-vault",
            "environment",
            "managed-identity"
          ]
        },
        "reference": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "A URI, environment variable name, or managed identity resource ID. Never a secret value."
        },
        "purpose": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "packageReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "package",
        "version",
        "source"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/slug"
        },
        "package": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source": {
          "enum": [
            "npm",
            "github-release",
            "repository"
          ]
        },
        "configurationSecretReferences": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mcpServers",
        "skills",
        "plugins"
      ],
      "properties": {
        "mcpServers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/packageReference"
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/packageReference"
          }
        },
        "plugins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/packageReference"
          }
        }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owningTeam",
        "technicalContact",
        "businessOwner",
        "costCenter"
      ],
      "properties": {
        "owningTeam": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "technicalContact": {
          "type": "string",
          "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
        },
        "businessOwner": {
          "type": "string",
          "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
        },
        "costCenter": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "createdByRelease",
        "upgradePolicy",
        "reviewAfter"
      ],
      "properties": {
        "stage": {
          "enum": [
            "planned",
            "active",
            "retiring"
          ]
        },
        "createdByRelease": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "upgradePolicy": {
          "enum": [
            "manual",
            "approved-minor",
            "approved-release"
          ]
        },
        "reviewAfter": {
          "type": "string",
          "format": "date"
        },
        "expiresOn": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "requiresApproval",
        "owner",
        "retainLogsDays"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "retain",
            "delete-deployments",
            "delete-resource-group"
          ]
        },
        "requiresApproval": {
          "const": true
        },
        "owner": {
          "type": "string",
          "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
        },
        "retainLogsDays": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
